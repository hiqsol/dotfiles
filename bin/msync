#!/usr/bin/env python3

import shlex
import subprocess
import sys

# pop the first argument, which is the script name
args = sys.argv
cmd = args.pop(0)
if len(args) < 3:
    sys.exit("usage: {} OPS SRC[,SRC...] DST [DST...]".format(cmd))
ops = args.pop(0)
srcs = args.pop(0)

excludes = "--exclude=.ccls-cache --exclude=.cache --exclude=.git --exclude=build --exclude=libcbdetect.a --exclude=ferro_navigation3/ferro_navigation3"

cmds = []
for src in srcs.split(","):
    for dst in args:
        line = ["rsync", "--filter=:- .gitignore"] + excludes.split() + shlex.split(ops) + [src, dst]
        cmds.append(line)

print(" & ".join(shlex.join(line) for line in cmds), flush=True)
procs = [subprocess.Popen(line) for line in cmds]
sys.exit(max(p.wait() for p in procs))
