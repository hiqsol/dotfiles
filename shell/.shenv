#!/bin/sh

export PATH=~/sbin:~/bin:~/.config/composer/vendor/bin:~/.local/bin:~/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
### Project-local bins go LAST so an untrusted repo cannot shadow system commands
export PATH="$PATH:./vendor/bin:./node_modules/.bin"

if ! xset q > /dev/null 2> /dev/null; then
    [ -z "$DISPLAY" ] && DISPLAY=":0"
    export DISPLAY
fi

export NVIM_LOG_FILE="$HOME/.cache/nvim/log"
if [ -f ~/.local/.shenv ]; then
    . ~/.local/.shenv
fi
