#!/bin/sh

### PATH lives in ~/.config/shell/shell.toml, run scripts/gen-shell after editing.
[ -f ~/.config/shell/generated.path.sh ] && . ~/.config/shell/generated.path.sh

if ! xset q > /dev/null 2> /dev/null; then
    [ -z "$DISPLAY" ] && DISPLAY=":0"
    export DISPLAY
fi

if [ -f ~/.local/.shenv ]; then
    . ~/.local/.shenv
fi
