#!/bin/sh

### Source shared functions
[ -f ~/.config/shell/functions.sh ] && . ~/.config/shell/functions.sh

### allow group write
umask 002

### PATH
export PATH=~/.local/share/mise/shims:~/sbin:~/bin:~/.config/composer/vendor/bin:~/.local/bin:~/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
### Project-local bins go LAST so an untrusted repo cannot shadow system commands
export PATH="$PATH:./vendor/bin:./node_modules/.bin"

### Simple env vars live in ~/.config/shell/shell.toml, run scripts/gen-shell after editing.
### Sourced before the logic below, which may override (e.g. LANG on Linux).
[ -f ~/.config/shell/generated.env.sh ] && . ~/.config/shell/generated.env.sh

### Activate english UTF8 locale and OS specific ls_options
ls_options=''
# shellcheck disable=SC2034 # used by cdls in functions.sh
if [ "$(uname)" = "Linux" ]; then
    export LANG=en_US.utf8
    export LC_ALL=en_US.utf8
    ls_options='--color'
fi

### SSH agent: stable symlink for tmux reattach
SOCK="/home/$USER/.ssh/ssh-agent.sock"
# Link to the resolved socket: wrappers (herdr) may hand us a link to $SOCK
_real=$(readlink -f "$SSH_AUTH_SOCK" 2>/dev/null)
if [ -n "$_real" ] && [ "$_real" != "$SOCK" ] && [ -S "$_real" ]; then
    ln -sfn "$_real" "$SOCK"
fi
unset _real
export SSH_AUTH_SOCK="$SOCK"
if [ ! -S "$SSH_AUTH_SOCK" ]; then
    reset_ssh_agent
fi

### fd is `fdfind` when installed from Debian/Ubuntu apt, `fd` otherwise (e.g. mise)
if command -v fdfind >/dev/null 2>&1; then _fd=fdfind; else _fd=fd; fi
export FZF_DEFAULT_COMMAND="$_fd --type f --strip-cwd-prefix -H -L -E .git"
unset _fd
